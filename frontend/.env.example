VITE_API_URL=https://your-api.railway.app/api

# Atlas anatomique 3D BioDigital Human (gratuit pour dev)
# 1. Crée un compte sur https://developer.biodigital.com/
# 2. Récupère ta "Developer Key" dans le dashboard
# 3. Colle-la ci-dessous (et dans les variables d'env Vercel)
VITE_BIODIGITAL_KEY=
# Optionnel : id du modèle anatomique (laisse vide pour le système musculaire par défaut)
VITE_BIODIGITAL_MODEL=
